"""Deterministic ffprobe stub: prints the input "video" file's `rate` entry."""
import sys

with open(sys.argv[-1], encoding="utf-8") as f:
    info = dict(line.split(": ", 1) for line in f.read().splitlines() if line)
print(info["rate"])
