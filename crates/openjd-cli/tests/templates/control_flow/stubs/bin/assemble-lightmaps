"""Deterministic assemble-lightmaps stub: lists the bakes in the directory."""
import os
import sys

bakes = sorted(n for n in os.listdir(sys.argv[1]) if n.endswith(".bake"))
print(f"assemble-lightmaps stub: {bakes}")
