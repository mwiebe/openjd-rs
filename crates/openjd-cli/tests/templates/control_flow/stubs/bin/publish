"""Deterministic publish stub: prints the pattern's file name and the note."""
import os
import sys

args = dict(zip(sys.argv[1::2], sys.argv[2::2]))
print(f"publish stub: {os.path.basename(args['--pattern'])} note: {args['--note']}")
