"""Deterministic bake-node stub: writes `--out` naming the node and its inputs."""
import os
import sys

argv = sys.argv[1:]
node = argv[argv.index("--node") + 1]
out = argv[argv.index("--out") + 1]
inputs = [os.path.basename(argv[i + 1]) for i, a in enumerate(argv) if a == "--input"]
for path in inputs:
    if not os.path.exists(os.path.join(os.path.dirname(out), path)):
        sys.exit(f"bake-node stub: input {path} of {node} has not been baked")
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w", encoding="utf-8") as f:
    f.write(f"{node} from {inputs}\n")
print(f"bake-node stub: {node} from {inputs} -> {os.path.basename(out)}")
