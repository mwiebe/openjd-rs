"""Deterministic stylize stub: writes `--out` from `--in`, with a marker."""
import os
import sys

args = dict(zip(sys.argv[1::2], sys.argv[2::2]))
src, dst = args["--in"], args["--out"]
# A Step run alone with --step has no extracted frames, so a missing input is
# reported rather than treated as an error.
note = "" if os.path.exists(src) else " (no input frame)"
os.makedirs(os.path.dirname(dst), exist_ok=True)
with open(dst, "w", encoding="utf-8") as f:
    f.write(f"stylized {os.path.basename(src)}\n")
print(f"stylize stub: {os.path.basename(src)} -> {os.path.basename(dst)}{note}")
